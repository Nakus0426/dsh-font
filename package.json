{
  "name": "dsh-font",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": ["lib", "cordis.patch.yml", "package.json"],
  "scripts": {
    "build": "pnpm build:host && pnpm build:client",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('lib',{recursive:true,force:true}))\""
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  },
  "dependencies": {
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
